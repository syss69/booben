# Пример для установки nginx на хост (не Docker).
# Скопируйте в sites-enabled / conf.d и поправьте root и upstream API.
#
# 1. Сборка:
#      VITE_API_URL=/api npm run build
# 2. Содержимое dist/ → /usr/share/nginx/html/  (не весь репозиторий)

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript;

    # Прокси на Reviewer API (как Vite proxy в dev)
    location /api/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
