# API base URL (no trailing slash). In dev you can use the Vite proxy instead.
VITE_API_URL=http://localhost:3000

# Set to /api to use Vite dev proxy (avoids CORS in development)
# VITE_API_URL=/api

# --- Vercel (frontend project) ---
# Recommended: same-origin proxy, no CORS
#   VITE_API_URL=/api
#   API_UPSTREAM=https://your-api.vercel.app
#
# Or direct calls to the API deployment (Nest on Vercel uses /api routes):
#   VITE_API_URL=https://your-api.vercel.app
#   (paths get /api automatically for *.vercel.app hosts)
# Or explicitly:
#   VITE_API_URL=https://your-api.vercel.app/api
#   VITE_API_INCLUDE_PREFIX=false
